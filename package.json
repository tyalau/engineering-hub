{
  "name": "engineering-hub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx,css,scss,md,json}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tyalau/commitlint-config": "workspace:*",
    "@tyalau/prettier-config": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "^3.8.2",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=24.14.1",
    "pnpm": ">=10.6.3"
  }
}
