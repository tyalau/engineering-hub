{
  "name": "engineering-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx,css,scss,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,ts,tsx,css,scss,md,json,yaml,yml}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@tyalau/commitlint-config": "workspace:*",
    "@tyalau/prettier-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=24.14.1",
    "pnpm": ">=10.6.3"
  }
}
