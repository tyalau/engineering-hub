{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["packages/typescript-config/*.json", "packages/eslint-config/*.js"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": {
      "env": ["PLAYWRIGHT_BROWSERS_PATH"],
      "dependsOn": ["^build"]
    },
    "lint": {},
    "check-types": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "dev": {
      "with": ["dev:styles", "dev:components"],
      "cache": false,
      "persistent": true
    },
    "dev:components": {
      "cache": false,
      "persistent": true
    },
    "dev:styles": {
      "cache": false,
      "persistent": true
    }
  }
}
