{
  "extends": "@tyalau/typescript-config/react-library",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.stories.*", "src/**/*.test.*", "src/**/*.spec.*"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@tyalau/ui/*": ["./src/*"]
    }
  }
}
