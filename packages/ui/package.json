{
  "name": "@tyalau/ui",
  "version": "0.0.0",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyalau/engineering-hub.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/tyalau/engineering-hub/tree/main/packages/ui#readme",
  "files": [
    "dist"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev:components": "tsc --watch",
    "dev:styles": "tailwindcss -i ./src/styles.css -o dist/styles.css --watch",
    "build:components": "tsc",
    "build:styles": "tailwindcss -i ./src/styles.css -o dist/styles.css --minify",
    "build": "pnpm clean && pnpm build:components && pnpm build:styles",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --run",
    "test:storybook": "vitest --run --project=storybook",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tyalau/eslint-config": "workspace:*",
    "@tyalau/typescript-config": "workspace:*",
    "@types/node": "^24.1.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "^10.6.2",
    "playwright": "^1.64.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.6",
    "shadcn": "^4.10.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "radix-ui": "^1.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
